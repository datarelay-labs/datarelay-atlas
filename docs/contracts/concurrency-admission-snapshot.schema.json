{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://atlas.datarelay.run/contracts/concurrency-admission-snapshot.schema.json",
  "title":"DataRelay Atlas Concurrency Admission Snapshot v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","kind","observed_at","graph","policy","execution_slots"],
  "properties":{
    "schema_version":{"type":"integer","const":1},
    "kind":{"type":"string","const":"concurrency_admission_snapshot"},
    "observed_at":{"$ref":"#/$defs/timestamp"},
    "graph":{"$ref":"https://datarelay.local/contracts/dependency-readiness-graph.schema.json"},
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["authority","max_parallel_admission","max_slot_evidence_age_seconds","project_limits"],
      "properties":{
        "authority":{"const":"ADMISSION_POLICY_ONLY"},
        "max_parallel_admission":{"type":"integer","minimum":1,"maximum":32},
        "max_slot_evidence_age_seconds":{"type":"integer","minimum":0,"maximum":31622400},
        "project_limits":{
          "type":"array","minItems":1,"maxItems":64,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["repository","max_wip"],
            "properties":{
              "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "max_wip":{"type":"integer","minimum":1,"maximum":32}
            }
          }
        }
      }
    },
    "execution_slots":{
      "type":"array","maxItems":64,
      "items":{"$ref":"#/$defs/slot"}
    }
  },
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@#\\-]{0,255}$"},
    "gate":{"enum":["ALLOW","DENY","UNKNOWN"]},
    "slot":{
      "type":"object","additionalProperties":false,
      "required":["slot_id","worker_id","provider","runtime","route_id","state","gates","evidence_ref","observed_at"],
      "properties":{
        "slot_id":{"$ref":"#/$defs/id"},
        "worker_id":{"$ref":"#/$defs/id"},
        "provider":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
        "runtime":{"$ref":"#/$defs/id"},
        "route_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
        "state":{"enum":["AVAILABLE","BUSY","UNAVAILABLE","UNKNOWN"]},
        "gates":{
          "type":"object","additionalProperties":false,
          "required":["trust","budget","rate","quota","blast_radius"],
          "properties":{
            "trust":{"$ref":"#/$defs/gate"},
            "budget":{"$ref":"#/$defs/gate"},
            "rate":{"$ref":"#/$defs/gate"},
            "quota":{"$ref":"#/$defs/gate"},
            "blast_radius":{"$ref":"#/$defs/gate"}
          }
        },
        "evidence_ref":{"$ref":"#/$defs/id"},
        "observed_at":{"$ref":"#/$defs/timestamp"}
      }
    }
  }
}
