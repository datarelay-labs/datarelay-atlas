{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/decision-plane-canary-request.schema.json",
  "title": "DataRelay Atlas Decision Plane Canary Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","kind","request_id","decision_class","expected_evidence_digest","scope","max_canary_decisions","evaluated_at","expires_at"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "kind": {"type":"string","const":"decision_plane_canary_request"},
    "request_id": {"$ref":"#/$defs/id"},
    "decision_class": {"enum":["OPTIONAL_CONTEXT_SELECTION","FOCUSED_CHECK_SELECTION"]},
    "expected_evidence_digest": {"$ref":"#/$defs/digest"},
    "scope": {
      "type":"object",
      "additionalProperties":false,
      "required":["project_id","path_prefixes","task_kinds"],
      "properties":{
        "project_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
        "path_prefixes":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
        "task_kinds":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
      }
    },
    "max_canary_decisions":{"type":"integer","minimum":1,"maximum":100},
    "evaluated_at":{"$ref":"#/$defs/timestamp"},
    "expires_at":{"$ref":"#/$defs/timestamp"}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,255}$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "path":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\\\\\).+$"},
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\\\.[0-9]{1,6})?Z$"}
  }
}
