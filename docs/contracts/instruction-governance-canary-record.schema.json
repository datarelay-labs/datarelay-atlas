{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/instruction-governance-canary-record.schema.json",
  "title": "DataRelay Atlas Instruction Governance Canary Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authority",
    "canary_id",
    "evaluated_at",
    "audit_identity",
    "disposition_digest",
    "handoff_digest",
    "target_repository",
    "target_head",
    "managed_changes",
    "result",
    "check_count",
    "checks",
    "adoption_request",
    "canary_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "instruction_governance_canary_record"
    },
    "authority": {
      "const": "CANARY_EVIDENCE_ONLY"
    },
    "canary_id": {
      "$ref": "#/$defs/id"
    },
    "evaluated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\\\.[0-9]{1,6})?Z$"
    },
    "audit_identity": {
      "$ref": "#/$defs/digest"
    },
    "disposition_digest": {
      "$ref": "#/$defs/digest"
    },
    "handoff_digest": {
      "$ref": "#/$defs/digest"
    },
    "target_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "managed_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "HUMAN_REQUIRED"
      ]
    },
    "check_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "adoption_request": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/adoption"
        }
      ]
    },
    "canary_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\\\-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_digest",
        "after_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/id"
        },
        "before_digest": {
          "$ref": "#/$defs/digest"
        },
        "after_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "outcome",
        "evidence_ref"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "HUMAN_REQUIRED"
          ]
        },
        "evidence_ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_repository",
        "target_head",
        "audit_identity",
        "disposition_digest",
        "handoff_digest",
        "canary_digest",
        "managed_changes",
        "canary_evidence_refs",
        "required_route",
        "mutation_authority",
        "merge_authority",
        "release_authority",
        "default_branch_authority",
        "request_digest"
      ],
      "properties": {
        "kind": {
          "const": "ordinary_pr_or_managed_adoption_request"
        },
        "target_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "target_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "audit_identity": {
          "$ref": "#/$defs/digest"
        },
        "disposition_digest": {
          "$ref": "#/$defs/digest"
        },
        "handoff_digest": {
          "$ref": "#/$defs/digest"
        },
        "canary_digest": {
          "$ref": "#/$defs/digest"
        },
        "managed_changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "canary_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "required_route": {
          "const": "ORDINARY_PR_OR_MANAGED_ADOPTION"
        },
        "mutation_authority": {
          "const": "NONE"
        },
        "merge_authority": {
          "const": "NONE"
        },
        "release_authority": {
          "const": "NONE"
        },
        "default_branch_authority": {
          "const": "NONE"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
