{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-route-catalog.schema.json",
  "title": "DataRelay Atlas Provider Route Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "authority", "routes"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "provider_route_catalog" },
    "authority": { "type": "string", "const": "CONFIGURATION_ONLY" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "routeId": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "adapter", "state"],
      "properties": {
        "route_id": { "$ref": "#/$defs/routeId" },
        "adapter": {
          "type": "string",
          "enum": ["CodexAuditProvider", "BoundedResponsesAuditProvider"]
        },
        "state": {
          "type": "string",
          "enum": ["ENABLED", "DISABLED"]
        }
      }
    }
  }
}
