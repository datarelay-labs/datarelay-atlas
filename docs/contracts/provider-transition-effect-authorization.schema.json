{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-transition-effect-authorization.schema.json",
  "title": "DataRelay Atlas Provider Transition Effect Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authority",
    "decision",
    "decision_reason",
    "transition_plan_digest",
    "current_state_digest",
    "plan_from_route_id",
    "plan_to_route_id",
    "current_route_id",
    "state_revision",
    "effect_epoch",
    "strategy",
    "required_capability",
    "attempt",
    "max_attempts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "provider_transition_effect_authorization" },
    "authority": {
      "type": "string",
      "enum": ["EFFECT_AUTHORIZATION_ONLY", "NO_EFFECT_AUTHORITY"]
    },
    "decision": { "type": "string", "enum": ["AUTHORIZED", "HUMAN_REQUIRED"] },
    "decision_reason": {
      "type": "string",
      "enum": ["EXACT_STATE_MATCH", "PLAN_REQUIRES_HUMAN", "CURRENT_ROUTE_MISMATCH"]
    },
    "transition_plan_digest": { "$ref": "#/$defs/digest" },
    "current_state_digest": { "$ref": "#/$defs/digest" },
    "plan_from_route_id": { "$ref": "#/$defs/routeId" },
    "plan_to_route_id": {
      "oneOf": [{ "$ref": "#/$defs/routeId" }, { "type": "null" }]
    },
    "current_route_id": { "$ref": "#/$defs/routeId" },
    "state_revision": { "$ref": "#/$defs/digest" },
    "effect_epoch": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "strategy": {
      "type": "string",
      "enum": ["CAPABILITY_FIRST", "STEWARDSHIP"]
    },
    "required_capability": { "$ref": "#/$defs/capability" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 32 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 32 }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "AUTHORIZED" } } },
      "then": {
        "properties": {
          "authority": { "const": "EFFECT_AUTHORIZATION_ONLY" },
          "decision_reason": { "const": "EXACT_STATE_MATCH" },
          "plan_to_route_id": { "$ref": "#/$defs/routeId" }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "HUMAN_REQUIRED" } } },
      "then": {
        "properties": {
          "authority": { "const": "NO_EFFECT_AUTHORITY" },
          "decision_reason": {
            "enum": ["PLAN_REQUIRES_HUMAN", "CURRENT_ROUTE_MISMATCH"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "decision_reason": { "const": "PLAN_REQUIRES_HUMAN" } }
      },
      "then": { "properties": { "plan_to_route_id": { "type": "null" } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "routeId": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "PLAN",
        "EFFORT_CONTROL",
        "COMPLETION_LOOP",
        "RUNTIME_VERIFY",
        "CODE_REVIEW",
        "SECOND_MODEL_ADVISOR",
        "PARALLEL_WORKERS",
        "PERIODIC_REENTRY",
        "PR_REWORK",
        "CONTEXT_USAGE",
        "CHECKPOINT_COMPACT",
        "SESSION_RESUME_RESET",
        "HARNESS_HEALTH_AUDIT",
        "PROMPT_INSTRUCTION_AUDIT",
        "SKILL_COST_AUDIT",
        "USAGE_INSIGHTS"
      ]
    }
  }
}
