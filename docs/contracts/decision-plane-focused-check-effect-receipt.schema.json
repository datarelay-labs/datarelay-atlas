{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/decision-plane-focused-check-effect-receipt.schema.json",
  "title": "DataRelay Atlas Decision Plane Focused Check Effect Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "activation_id",
    "canary_request_id",
    "admission_digest",
    "decision_class",
    "project_id",
    "task_kind",
    "activated_at",
    "candidate_digest",
    "changed_paths",
    "affected_domains",
    "candidate_ids",
    "terminal_required_ids",
    "selected_candidate_ids",
    "result",
    "fallback_reason",
    "selector_attribution",
    "authority",
    "permission_authority",
    "release_authority",
    "deploy_authority",
    "pass_authority",
    "human_required_authority",
    "rollout_state"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "decision_plane_focused_check_effect_receipt"
    },
    "activation_id": {
      "$ref": "#/$defs/id"
    },
    "canary_request_id": {
      "$ref": "#/$defs/id"
    },
    "admission_digest": {
      "$ref": "#/$defs/digest"
    },
    "decision_class": {
      "const": "FOCUSED_CHECK_SELECTION"
    },
    "project_id": {
      "$ref": "#/$defs/id"
    },
    "task_kind": {
      "$ref": "#/$defs/id"
    },
    "activated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "candidate_digest": {
      "$ref": "#/$defs/digest"
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "affected_domains": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "candidate_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "terminal_required_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "selected_candidate_ids": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "result": {
      "enum": [
        "APPLIED_CANARY",
        "FALLBACK",
        "NO_EFFECT"
      ]
    },
    "fallback_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector_attribution": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/attribution"
        }
      ]
    },
    "authority": {
      "const": "FOCUSED_CHECK_SELECTION_ONLY"
    },
    "permission_authority": {
      "const": "NONE"
    },
    "release_authority": {
      "const": "NONE"
    },
    "deploy_authority": {
      "const": "NONE"
    },
    "pass_authority": {
      "const": "NONE"
    },
    "human_required_authority": {
      "const": "NONE"
    },
    "rollout_state": {
      "const": "LIMITED_ACTIVE"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+#\\-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "profile",
        "decision_ref"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/id"
        },
        "model": {
          "$ref": "#/$defs/id"
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "decision_ref": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
