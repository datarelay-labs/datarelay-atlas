{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://atlas.datarelay.run/contracts/concurrency-run-observation.schema.json",
  "title":"DataRelay Atlas Concurrency Run Observation v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","kind","run_id","plan_digest","started_at","completed_at","outcomes"],
  "properties":{
    "schema_version":{"type":"integer","const":1},
    "kind":{"type":"string","const":"concurrency_run_observation"},
    "run_id":{"$ref":"#/$defs/id"},
    "plan_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "started_at":{"$ref":"#/$defs/timestamp"},
    "completed_at":{"$ref":"#/$defs/timestamp"},
    "outcomes":{
      "type":"array","maxItems":32,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["node_id","slot_id","worker_id","provider","outcome","duration_ms","evidence_ref"],
        "properties":{
          "node_id":{"$ref":"#/$defs/id"},
          "slot_id":{"$ref":"#/$defs/id"},
          "worker_id":{"$ref":"#/$defs/id"},
          "provider":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{0,63}$"},
          "outcome":{"enum":["COMPLETE","FAILED","HUMAN_REQUIRED"]},
          "duration_ms":{"type":"integer","minimum":0,"maximum":604800000},
          "evidence_ref":{"$ref":"#/$defs/id"}
        }
      }
    }
  },
  "$defs":{
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@#\\-]{0,255}$"}
  }
}
