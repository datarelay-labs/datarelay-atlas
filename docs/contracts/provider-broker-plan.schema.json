{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-broker-plan.schema.json",
  "title": "DataRelay Atlas Provider Broker Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "strategy",
    "required_capability",
    "authority",
    "selected_route_id",
    "fallback_route_ids",
    "eligible_routes",
    "ineligible_routes"
  ],
  "anyOf": [
    {
      "properties": { "eligible_routes": { "minItems": 1 } },
      "required": ["eligible_routes"]
    },
    {
      "properties": { "ineligible_routes": { "minItems": 1 } },
      "required": ["ineligible_routes"]
    }
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "provider_broker_plan" },
    "strategy": {
      "type": "string",
      "enum": ["CAPABILITY_FIRST", "STEWARDSHIP"]
    },
    "required_capability": { "$ref": "#/$defs/capability" },
    "authority": { "type": "string", "const": "ADVISORY_ONLY" },
    "selected_route_id": {
      "oneOf": [{ "$ref": "#/$defs/routeId" }, { "type": "null" }]
    },
    "fallback_route_ids": {
      "type": "array",
      "maxItems": 31,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routeId" }
    },
    "eligible_routes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/eligibleRoute" }
    },
    "ineligible_routes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/ineligibleRoute" }
    }
  },
  "$defs": {
    "routeId": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "providerIdentity": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$"
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "capability": {
      "type": "string",
      "enum": [
        "PLAN",
        "EFFORT_CONTROL",
        "COMPLETION_LOOP",
        "RUNTIME_VERIFY",
        "CODE_REVIEW",
        "SECOND_MODEL_ADVISOR",
        "PARALLEL_WORKERS",
        "PERIODIC_REENTRY",
        "PR_REWORK",
        "CONTEXT_USAGE",
        "CHECKPOINT_COMPACT",
        "SESSION_RESUME_RESET",
        "HARNESS_HEALTH_AUDIT",
        "PROMPT_INSTRUCTION_AUDIT",
        "SKILL_COST_AUDIT",
        "USAGE_INSIGHTS"
      ]
    },
    "ineligibleReason": {
      "type": "string",
      "enum": [
        "POLICY_DENY",
        "POLICY_UNKNOWN",
        "TRUST_DENY",
        "TRUST_UNKNOWN",
        "BUDGET_DENY",
        "BUDGET_UNKNOWN",
        "USAGE_MODE_DENY",
        "USAGE_MODE_UNKNOWN",
        "BLAST_RADIUS_DENY",
        "BLAST_RADIUS_UNKNOWN",
        "WIP_DENY",
        "WIP_UNKNOWN",
        "CAPABILITY_NOT_DECLARED",
        "CAPABILITY_UNSUPPORTED",
        "CAPABILITY_UNKNOWN",
        "REMAINING_CAPACITY_UNKNOWN",
        "REMAINING_CAPACITY_EXHAUSTED"
      ]
    },
    "eligibleRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "provider",
        "runtime",
        "usage_mode",
        "reasons",
        "rank"
      ],
      "properties": {
        "route_id": { "$ref": "#/$defs/routeId" },
        "provider": { "$ref": "#/$defs/providerIdentity" },
        "runtime": { "$ref": "#/$defs/identity" },
        "usage_mode": { "$ref": "#/$defs/identity" },
        "reasons": {
          "type": "array",
          "prefixItems": [{ "type": "string", "const": "ELIGIBLE" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "rank": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/rank" },
            { "$ref": "#/$defs/rank" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "ineligibleRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "provider",
        "runtime",
        "usage_mode",
        "reasons"
      ],
      "properties": {
        "route_id": { "$ref": "#/$defs/routeId" },
        "provider": { "$ref": "#/$defs/providerIdentity" },
        "runtime": { "$ref": "#/$defs/identity" },
        "usage_mode": { "$ref": "#/$defs/identity" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ineligibleReason" }
        }
      }
    }
  }
}
