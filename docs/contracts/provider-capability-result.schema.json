{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-capability-result.schema.json",
  "title": "DataRelay Atlas Provider Capability Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "capability",
    "provider",
    "runtime",
    "usage_mode",
    "adapter",
    "result_contract",
    "outcome",
    "evidence",
    "authority"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "provider_capability_result"
    },
    "capability": {
      "type": "string",
      "const": "CODE_REVIEW"
    },
    "provider": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "runtime": {
      "$ref": "#/$defs/identity"
    },
    "usage_mode": {
      "$ref": "#/$defs/identity"
    },
    "adapter": {
      "$ref": "#/$defs/identity"
    },
    "result_contract": {
      "type": "string",
      "const": "audit_result_v1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "REWORK",
        "HUMAN_REQUIRED"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_head",
        "evidence_ref"
      ],
      "properties": {
        "subject_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"
        }
      }
    },
    "authority": {
      "type": "string",
      "const": "EVIDENCE_ONLY"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9][A-Za-z0-9_.:@+-]{0,127}$"
    }
  }
}
