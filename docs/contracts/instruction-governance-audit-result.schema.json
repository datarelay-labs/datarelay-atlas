{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/instruction-governance-audit-result.schema.json",
  "title": "DataRelay Atlas Instruction Governance Audit Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","kind","audit_identity","evaluated_at",
    "behavior_results","candidate_changes","evaluation_ref"
  ],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "kind": {"type":"string","const":"instruction_governance_audit_result"},
    "audit_identity": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evaluated_at": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "behavior_results": {
      "type":"array","maxItems":128,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["scenario_id","outcome"],
        "properties":{
          "scenario_id":{"$ref":"#/$defs/id"},
          "outcome":{"enum":["PASS","FAIL","UNKNOWN"]}
        }
      }
    },
    "candidate_changes": {
      "type":"array","maxItems":32,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["path","before_digest","after_digest"],
        "properties":{
          "path":{"$ref":"#/$defs/id"},
          "before_digest":{"$ref":"#/$defs/digest"},
          "after_digest":{"$ref":"#/$defs/digest"}
        }
      }
    },
    "evaluation_ref":{"$ref":"#/$defs/id"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/@+\\-]{0,255}$"}
  }
}
