{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-transition-plan.schema.json",
  "title": "DataRelay Atlas Provider Transition Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authority",
    "decision",
    "decision_reason",
    "strategy",
    "required_capability",
    "failure_reason",
    "from_route_id",
    "to_route_id",
    "prior_failed_route_ids",
    "failed_route_ids",
    "attempt",
    "max_attempts",
    "remaining_plan"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "provider_route_transition_plan" },
    "authority": { "type": "string", "const": "ADVISORY_ONLY" },
    "decision": {
      "type": "string",
      "enum": ["TRANSITION_RECOMMENDED", "HUMAN_REQUIRED"]
    },
    "decision_reason": {
      "type": "string",
      "enum": [
        "ELIGIBLE_FALLBACK",
        "ATTEMPT_LIMIT_REACHED",
        "NO_REMAINING_ROUTES",
        "NO_ELIGIBLE_FALLBACK"
      ]
    },
    "strategy": {
      "type": "string",
      "enum": ["CAPABILITY_FIRST", "STEWARDSHIP"]
    },
    "required_capability": { "$ref": "#/$defs/capability" },
    "failure_reason": {
      "type": "string",
      "enum": [
        "QUOTA_EXHAUSTED",
        "RATE_LIMITED",
        "HEALTH_UNAVAILABLE",
        "RUNTIME_UNAVAILABLE",
        "OPERATOR_REQUEST"
      ]
    },
    "from_route_id": { "$ref": "#/$defs/routeId" },
    "to_route_id": {
      "oneOf": [{ "$ref": "#/$defs/routeId" }, { "type": "null" }]
    },
    "prior_failed_route_ids": {
      "type": "array",
      "maxItems": 31,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routeId" }
    },
    "failed_route_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/routeId" }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "remaining_plan": {
      "oneOf": [
        { "$ref": "https://datarelay.local/contracts/provider-broker-plan.schema.json" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": { "const": "TRANSITION_RECOMMENDED" }
        }
      },
      "then": {
        "properties": {
          "decision_reason": { "const": "ELIGIBLE_FALLBACK" },
          "to_route_id": { "$ref": "#/$defs/routeId" },
          "remaining_plan": {
            "allOf": [
              {
                "$ref": "https://datarelay.local/contracts/provider-broker-plan.schema.json"
              },
              {
                "properties": {
                  "selected_route_id": { "$ref": "#/$defs/routeId" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "const": "HUMAN_REQUIRED" }
        }
      },
      "then": {
        "properties": {
          "decision_reason": {
            "enum": [
              "ATTEMPT_LIMIT_REACHED",
              "NO_REMAINING_ROUTES",
              "NO_ELIGIBLE_FALLBACK"
            ]
          },
          "to_route_id": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_reason": { "const": "NO_REMAINING_ROUTES" }
        }
      },
      "then": {
        "properties": {
          "decision": { "const": "HUMAN_REQUIRED" },
          "remaining_plan": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_reason": { "const": "NO_ELIGIBLE_FALLBACK" }
        }
      },
      "then": {
        "properties": {
          "decision": { "const": "HUMAN_REQUIRED" },
          "remaining_plan": {
            "allOf": [
              {
                "$ref": "https://datarelay.local/contracts/provider-broker-plan.schema.json"
              },
              {
                "properties": {
                  "selected_route_id": { "type": "null" }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "routeId": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capability": {
      "type": "string",
      "enum": [
        "PLAN",
        "EFFORT_CONTROL",
        "COMPLETION_LOOP",
        "RUNTIME_VERIFY",
        "CODE_REVIEW",
        "SECOND_MODEL_ADVISOR",
        "PARALLEL_WORKERS",
        "PERIODIC_REENTRY",
        "PR_REWORK",
        "CONTEXT_USAGE",
        "CHECKPOINT_COMPACT",
        "SESSION_RESUME_RESET",
        "HARNESS_HEALTH_AUDIT",
        "PROMPT_INSTRUCTION_AUDIT",
        "SKILL_COST_AUDIT",
        "USAGE_INSIGHTS"
      ]
    }
  }
}
