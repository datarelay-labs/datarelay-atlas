{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-route-candidate.schema.json",
  "title": "DataRelay Atlas Provider Route Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "route_id",
    "capability_descriptor",
    "capacity_input",
    "gates",
    "ranks"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "provider_route_candidate" },
    "route_id": {
      "type": "string",
      "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "capability_descriptor": {
      "$ref": "https://datarelay.local/contracts/provider-capability-descriptor.schema.json"
    },
    "capacity_input": {
      "$ref": "https://datarelay.local/contracts/provider-capacity-input.schema.json"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "trust",
        "budget",
        "usage_mode",
        "blast_radius",
        "wip"
      ],
      "properties": {
        "policy": { "$ref": "#/$defs/gate" },
        "trust": { "$ref": "#/$defs/gate" },
        "budget": { "$ref": "#/$defs/gate" },
        "usage_mode": { "$ref": "#/$defs/gate" },
        "blast_radius": { "$ref": "#/$defs/gate" },
        "wip": { "$ref": "#/$defs/gate" }
      }
    },
    "ranks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_preference", "stewardship_preference"],
      "properties": {
        "capability_preference": { "$ref": "#/$defs/rank" },
        "stewardship_preference": { "$ref": "#/$defs/rank" }
      }
    },
    "capacity_attribution": {
      "$ref": "https://datarelay.local/contracts/provider-capacity-attribution.schema.json"
    }
  },
  "$defs": {
    "gate": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "UNKNOWN"]
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
