{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/concurrency-claim-bound-join-observation.schema.json",
  "title": "DataRelay Atlas Concurrency Claim-Bound Join Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "claim_join_id",
    "dispatch_join_digest",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "concurrency_claim_bound_join_observation"
    },
    "claim_join_id": {
      "$ref": "#/$defs/id"
    },
    "dispatch_join_digest": {
      "$ref": "#/$defs/digest"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "claim_digest"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/id"
          },
          "claim_digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#+\\-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
