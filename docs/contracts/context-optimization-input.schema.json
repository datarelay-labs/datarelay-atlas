{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/context-optimization-input.schema.json",
  "title": "DataRelay Atlas Context Optimization Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scope",
    "source_evidence",
    "gates",
    "control_mode",
    "arms"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "context_optimization_input" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "task_kind", "profile"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "DESIGN", "DEVELOPMENT", "TEST", "REVIEW", "RELEASE",
            "OPERATIONS", "ADOPTION", "DOCUMENTATION", "CLEANUP", "MIXED"
          ]
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "reasoning", "toolset"],
          "properties": {
            "provider": { "$ref": "#/$defs/profileLabel" },
            "model": { "$ref": "#/$defs/profileLabel" },
            "reasoning": { "$ref": "#/$defs/profileLabel" },
            "toolset": { "$ref": "#/$defs/profileLabel" }
          }
        }
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_schema_version",
        "system_head",
        "comparability",
        "record_count",
        "arm_count"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "engineering_system_context_canary_v1",
            "engineering_system_context_canary_v2"
          ]
        },
        "source_schema_version": { "type": "integer", "enum": [1, 2] },
        "system_head": { "$ref": "#/$defs/head" },
        "comparability": { "type": "string", "const": "ELIGIBLE" },
        "record_count": { "$ref": "#/$defs/recordCount" },
        "arm_count": { "type": "integer", "minimum": 2, "maximum": 256 },
        "run_set_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_schema_version": { "const": 1 }
            }
          },
          "then": {
            "properties": {
              "source_kind": { "const": "engineering_system_context_canary_v1" }
            },
            "not": { "required": ["run_set_digest"] }
          }
        },
        {
          "if": {
            "properties": {
              "source_schema_version": { "const": 2 }
            }
          },
          "then": {
            "properties": {
              "source_kind": { "const": "engineering_system_context_canary_v2" }
            },
            "required": ["run_set_digest"]
          }
        }
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_noninferiority",
        "data_egress_eligibility",
        "runtime_capability",
        "active_control"
      ],
      "properties": {
        "quality_noninferiority": {
          "type": "string",
          "enum": ["UNKNOWN", "SHADOW_ACTION_EQUIVALENT"]
        },
        "data_egress_eligibility": {
          "type": "string",
          "enum": ["UNKNOWN", "LOCAL_CANARY_EGRESS_DENY_VERIFIED"]
        },
        "runtime_capability": {
          "type": "string",
          "enum": ["UNKNOWN", "LEARNED_COMPRESSOR_LOCAL_CANARY_READY"]
        },
        "active_control": { "type": "string", "const": "NOT_ELIGIBLE_FOR_ACTIVE_CONTROL" }
      }
    },
    "control_mode": { "type": "string", "const": "OBSERVE_ONLY" },
    "quality_evidence": { "$ref": "#/$defs/shadowQuality" },
    "learned_canary_evidence": { "$ref": "#/$defs/learnedCanaryEvidence" },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/arm" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "quality_noninferiority": {
                "const": "SHADOW_ACTION_EQUIVALENT"
              }
            }
          }
        }
      },
      "then": { "required": ["quality_evidence"] }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "quality_noninferiority": { "const": "UNKNOWN" }
            }
          }
        }
      },
      "then": {
        "not": { "required": ["quality_evidence"] }
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "data_egress_eligibility": {
                "const": "LOCAL_CANARY_EGRESS_DENY_VERIFIED"
              }
            }
          }
        }
      },
      "then": {
        "required": ["learned_canary_evidence"],
        "properties": {
          "gates": {
            "properties": {
              "runtime_capability": {
                "const": "LEARNED_COMPRESSOR_LOCAL_CANARY_READY"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "runtime_capability": {
                "const": "LEARNED_COMPRESSOR_LOCAL_CANARY_READY"
              }
            }
          }
        }
      },
      "then": {
        "required": ["learned_canary_evidence"],
        "properties": {
          "gates": {
            "properties": {
              "data_egress_eligibility": {
                "const": "LOCAL_CANARY_EGRESS_DENY_VERIFIED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["learned_canary_evidence"],
        "properties": {
          "learned_canary_evidence": {
            "properties": {
              "decision": { "const": "CANARY_READY" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "data_egress_eligibility": {
                "const": "LOCAL_CANARY_EGRESS_DENY_VERIFIED"
              },
              "runtime_capability": {
                "const": "LEARNED_COMPRESSOR_LOCAL_CANARY_READY"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["learned_canary_evidence"],
        "properties": {
          "learned_canary_evidence": {
            "properties": {
              "decision": { "const": "SETUP_ALLOWED" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "data_egress_eligibility": { "const": "UNKNOWN" },
              "runtime_capability": { "const": "UNKNOWN" }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": { "required": ["learned_canary_evidence"] }
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "data_egress_eligibility": { "const": "UNKNOWN" },
              "runtime_capability": { "const": "UNKNOWN" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profileLabel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@\\[\\]=,+-]{1,80}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "runCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "usageTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25600000000
    },
    "effortTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256000000
    },
    "reworkTotal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 768000000
    },
    "decimal": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "shadowArm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_id", "run_count", "material_action_count"],
      "properties": {
        "arm_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "run_count": { "$ref": "#/$defs/runCount" },
        "material_action_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "shadowQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_schema_version",
        "decision",
        "control_arm_id",
        "system_head",
        "repository",
        "task_kind",
        "run_set_digest",
        "case_count",
        "arm_count",
        "observation_count",
        "arms"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "const": "engineering_system_context_shadow_v2"
        },
        "source_schema_version": { "type": "integer", "const": 2 },
        "decision": { "type": "string", "const": "EQUIVALENT" },
        "control_arm_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "system_head": { "$ref": "#/$defs/head" },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "DESIGN", "DEVELOPMENT", "TEST", "REVIEW", "RELEASE",
            "OPERATIONS", "ADOPTION", "DOCUMENTATION", "CLEANUP", "MIXED"
          ]
        },
        "run_set_digest": { "$ref": "#/$defs/digest" },
        "case_count": { "$ref": "#/$defs/runCount" },
        "arm_count": { "type": "integer", "minimum": 2, "maximum": 256 },
        "observation_count": { "$ref": "#/$defs/recordCount" },
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/shadowArm" }
        }
      }
    },
    "learnedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "source_repo",
        "source_commit",
        "package_version",
        "license",
        "integration_mode"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "source_repo": {
          "type": "string",
          "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_commit": { "$ref": "#/$defs/head" },
        "package_version": {
          "type": "string",
          "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9_.+-]{1,40}$"
        },
        "license": {
          "type": "string",
          "pattern": "^(?!(?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))(?!.*[^A-Za-z0-9](?:sk-|ghp_|github_pat_|AKIA|-----BEGIN))[A-Za-z0-9.-]{1,40}$"
        },
        "integration_mode": {
          "type": "string",
          "const": "LOCAL_SELF_HOST"
        }
      }
    },
    "learnedRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "endpoint_class",
        "external_egress",
        "protected_state_route",
        "deterministic_bypass",
        "exact_original_recovery_verified",
        "identifier_preservation_verified",
        "cache_behavior_verified",
        "provider_usage_capture_ready",
        "live_comparability_gate_available",
        "shadow_equivalence_gate_available",
        "trusted_runtime_evidence"
      ],
      "properties": {
        "execution_mode": { "type": "boolean" },
        "endpoint_class": { "type": "boolean" },
        "external_egress": { "type": "boolean" },
        "protected_state_route": { "type": "boolean" },
        "deterministic_bypass": { "type": "boolean" },
        "exact_original_recovery_verified": { "type": "boolean" },
        "identifier_preservation_verified": { "type": "boolean" },
        "cache_behavior_verified": { "type": "boolean" },
        "provider_usage_capture_ready": { "type": "boolean" },
        "live_comparability_gate_available": { "type": "boolean" },
        "shadow_equivalence_gate_available": { "type": "boolean" },
        "trusted_runtime_evidence": { "type": "boolean" }
      }
    },
    "learnedCanaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_schema_version",
        "decision",
        "setup_allowed",
        "canary_ready",
        "candidate",
        "requirements",
        "blockers"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "const": "engineering_system_context_learned_canary_v1"
        },
        "source_schema_version": { "type": "integer", "const": 1 },
        "decision": {
          "type": "string",
          "enum": ["SETUP_ALLOWED", "CANARY_READY"]
        },
        "setup_allowed": { "type": "boolean", "const": true },
        "canary_ready": { "type": "boolean" },
        "candidate": { "$ref": "#/$defs/learnedCandidate" },
        "requirements": { "$ref": "#/$defs/learnedRequirements" },
        "blockers": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "EXECUTION_MODE_NOT_LOCAL",
              "ENDPOINT_NOT_LOOPBACK",
              "EXTERNAL_EGRESS_NOT_DENIED",
              "PROTECTED_STATE_NOT_BYPASSED",
              "DETERMINISTIC_BYPASS_UNVERIFIED",
              "EXACT_RECOVERY_UNVERIFIED",
              "IDENTIFIER_PRESERVATION_UNVERIFIED",
              "CACHE_BEHAVIOR_UNVERIFIED",
              "PROVIDER_USAGE_CAPTURE_NOT_READY",
              "LIVE_COMPARABILITY_GATE_UNAVAILABLE",
              "SHADOW_EQUIVALENCE_GATE_UNAVAILABLE",
              "RUNTIME_BINDING_REQUIRED",
              "TRUST_BOUNDARY_REQUIRED",
              "TRUST_BOUNDARY_UNTRUSTED",
              "TRUST_BOUNDARY_INVALID",
              "TRUST_REPO_MISMATCH",
              "TRUST_WORKSTREAM_MISMATCH",
              "TRUST_REVISION_MISMATCH",
              "TRUST_SUBJECT_HEAD_MISMATCH",
              "TRUST_RUNTIME_SUBJECT_MISMATCH",
              "TRUST_EVIDENCE_STALE_HEAD",
              "TRUST_EVIDENCE_STALE_REVISION",
              "TRUST_EVIDENCE_DUPLICATE",
              "TRUST_EVIDENCE_UNKNOWN",
              "TRUST_EVIDENCE_MISSING",
              "TRUST_EVIDENCE_NOT_PASS"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": { "const": "CANARY_READY" }
            }
          },
          "then": {
            "properties": {
              "canary_ready": { "const": true },
              "blockers": { "maxItems": 0 },
              "requirements": {
                "properties": {
                  "execution_mode": { "const": true },
                  "endpoint_class": { "const": true },
                  "external_egress": { "const": true },
                  "protected_state_route": { "const": true },
                  "deterministic_bypass": { "const": true },
                  "exact_original_recovery_verified": { "const": true },
                  "identifier_preservation_verified": { "const": true },
                  "cache_behavior_verified": { "const": true },
                  "provider_usage_capture_ready": { "const": true },
                  "live_comparability_gate_available": { "const": true },
                  "shadow_equivalence_gate_available": { "const": true },
                  "trusted_runtime_evidence": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "SETUP_ALLOWED" }
            }
          },
          "then": {
            "properties": {
              "canary_ready": { "const": false },
              "blockers": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "system_head",
        "run_count",
        "verified_solved_count",
        "original_context_bytes",
        "kept_context_bytes",
        "reduction_ratio",
        "provider_cost_total",
        "cost_per_verified_solved_task",
        "rework_total",
        "input_tokens_total",
        "output_tokens_total",
        "cache_read_tokens_total",
        "cache_write_tokens_total",
        "tool_turns_total",
        "retries_total",
        "rereads_total",
        "compactions_total",
        "pr_rework_total",
        "ci_rework_total",
        "review_rework_total",
        "human_interventions_total"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "system_head": { "$ref": "#/$defs/head" },
        "run_count": { "$ref": "#/$defs/runCount" },
        "verified_solved_count": { "$ref": "#/$defs/recordCount" },
        "original_context_bytes": { "$ref": "#/$defs/count" },
        "kept_context_bytes": { "$ref": "#/$defs/count" },
        "reduction_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "provider_cost_total": { "$ref": "#/$defs/decimal" },
        "cost_per_verified_solved_task": { "$ref": "#/$defs/decimal" },
        "rework_total": { "$ref": "#/$defs/reworkTotal" },
        "input_tokens_total": { "$ref": "#/$defs/usageTotal" },
        "output_tokens_total": { "$ref": "#/$defs/usageTotal" },
        "cache_read_tokens_total": { "$ref": "#/$defs/usageTotal" },
        "cache_write_tokens_total": { "$ref": "#/$defs/usageTotal" },
        "tool_turns_total": { "$ref": "#/$defs/effortTotal" },
        "retries_total": { "$ref": "#/$defs/effortTotal" },
        "rereads_total": { "$ref": "#/$defs/effortTotal" },
        "compactions_total": { "$ref": "#/$defs/effortTotal" },
        "pr_rework_total": { "$ref": "#/$defs/effortTotal" },
        "ci_rework_total": { "$ref": "#/$defs/effortTotal" },
        "review_rework_total": { "$ref": "#/$defs/effortTotal" },
        "human_interventions_total": { "$ref": "#/$defs/effortTotal" }
      }
    }
  }
}
