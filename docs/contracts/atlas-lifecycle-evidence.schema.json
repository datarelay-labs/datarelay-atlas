{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.run/schemas/atlas-lifecycle-evidence-v2.json",
  "title": "Atlas Lifecycle Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "observed_at",
    "repository",
    "candidate_head",
    "channels",
    "human_equivalent_user_tests"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "atlas_lifecycle_evidence" },
    "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "candidate_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": { "$ref": "#/$defs/machineEvidence" },
        "tests": { "$ref": "#/$defs/machineEvidence" },
        "release": { "$ref": "#/$defs/machineEvidence" }
      }
    },
    "human_equivalent_user_tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_reconciliation": { "$ref": "#/$defs/humanGate" },
        "full_user_e2e": { "$ref": "#/$defs/humanGate" }
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@#?=&%+\\-]{0,511}$"
    },
    "machineEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "detail", "evidence_ref"],
      "properties": {
        "outcome": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "detail": { "type": "string", "minLength": 1, "maxLength": 256 },
        "evidence_ref": { "$ref": "#/$defs/evidenceRef" }
      }
    },
    "humanGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "configured", "outcome", "detail", "evidence_ref"],
      "properties": {
        "required": { "type": "boolean" },
        "configured": { "type": "boolean" },
        "outcome": { "type": ["string", "null"], "enum": ["PASS", "FAIL", "BLOCKED", null] },
        "detail": { "type": ["string", "null"], "maxLength": 256 },
        "evidence_ref": { "anyOf": [{ "$ref": "#/$defs/evidenceRef" }, { "type": "null" }] }
      }
    }
  }
}
