{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.local/contracts/provider-capacity-attribution.schema.json",
  "title": "DataRelay Atlas Provider Capacity Attribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "provider",
    "evidence",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "provider_capacity_attribution"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_kind",
        "observed_at"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "enum": [
            "PROVIDER_AUTHORITATIVE",
            "UNVERIFIED"
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/label"
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_surface",
        "allowance_domain",
        "shared_allowance",
        "charging_mode"
      ],
      "properties": {
        "execution_surface": {
          "$ref": "#/$defs/labelFact"
        },
        "allowance_domain": {
          "$ref": "#/$defs/labelFact"
        },
        "shared_allowance": {
          "$ref": "#/$defs/boolFact"
        },
        "charging_mode": {
          "$ref": "#/$defs/labelFact"
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "unknownFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "UNKNOWN"
        }
      }
    },
    "observedLabelFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "OBSERVED"
        },
        "value": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "observedBoolFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "const": "OBSERVED"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "labelFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknownFact"
        },
        {
          "$ref": "#/$defs/observedLabelFact"
        }
      ]
    },
    "boolFact": {
      "oneOf": [
        {
          "$ref": "#/$defs/unknownFact"
        },
        {
          "$ref": "#/$defs/observedBoolFact"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "authority": {
                "const": "UNVERIFIED"
              }
            },
            "required": [
              "authority"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "observed_at": {
                "type": "null"
              }
            }
          },
          "facts": {
            "properties": {
              "execution_surface": {
                "$ref": "#/$defs/unknownFact"
              },
              "allowance_domain": {
                "$ref": "#/$defs/unknownFact"
              },
              "shared_allowance": {
                "$ref": "#/$defs/unknownFact"
              },
              "charging_mode": {
                "$ref": "#/$defs/unknownFact"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "authority": {
                "const": "PROVIDER_AUTHORITATIVE"
              }
            },
            "required": [
              "authority"
            ]
          }
        },
        "required": [
          "evidence"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      }
    }
  ]
}
