{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.datarelay.run/contracts/instruction-governance-disposition.schema.json",
  "title": "DataRelay Atlas Instruction Governance Disposition / PR Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "authority",
    "mutation_authority",
    "disposition",
    "reasons",
    "audit_identity",
    "audit_outcome",
    "target_repository",
    "target_head",
    "inventory_digest",
    "engineering_system_revision",
    "model_provider",
    "model_name",
    "model_profile",
    "harness_id",
    "harness_revision",
    "evaluation_ref",
    "candidate_changes",
    "behavior_results",
    "missing_mandatory_scenarios",
    "pr_handoff",
    "disposition_digest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "instruction_governance_disposition"
    },
    "authority": {
      "const": "PR_HANDOFF_ADVISORY_ONLY"
    },
    "mutation_authority": {
      "const": "NONE"
    },
    "disposition": {
      "enum": [
        "NO_CHANGE",
        "PR_CANDIDATE",
        "HUMAN_REQUIRED",
        "REJECTED"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "audit_identity": {
      "$ref": "#/$defs/digest"
    },
    "audit_outcome": {
      "enum": [
        "NO_CHANGE",
        "CANARY_READY",
        "HUMAN_REQUIRED",
        "REJECTED"
      ]
    },
    "target_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "target_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inventory_digest": {
      "$ref": "#/$defs/digest"
    },
    "engineering_system_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model_provider": {
      "$ref": "#/$defs/id"
    },
    "model_name": {
      "$ref": "#/$defs/id"
    },
    "model_profile": {
      "$ref": "#/$defs/id"
    },
    "harness_id": {
      "$ref": "#/$defs/id"
    },
    "harness_revision": {
      "$ref": "#/$defs/id"
    },
    "evaluation_ref": {
      "$ref": "#/$defs/id"
    },
    "candidate_changes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "behavior_results": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "missing_mandatory_scenarios": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "pr_handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/handoff"
        }
      ]
    },
    "disposition_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+\\\\-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_digest",
        "after_digest"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/id"
        },
        "before_digest": {
          "$ref": "#/$defs/digest"
        },
        "after_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "outcome"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_repository",
        "target_head",
        "audit_identity",
        "engineering_system_revision",
        "evaluation_ref",
        "managed_changes",
        "required_route",
        "merge_authority",
        "release_authority",
        "handoff_digest"
      ],
      "properties": {
        "kind": {
          "const": "ordinary_pr_adoption_handoff"
        },
        "target_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "target_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "audit_identity": {
          "$ref": "#/$defs/digest"
        },
        "engineering_system_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/id"
        },
        "managed_changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "required_route": {
          "const": "ORDINARY_PR_OR_MANAGED_ADOPTION"
        },
        "merge_authority": {
          "const": "NONE"
        },
        "release_authority": {
          "const": "NONE"
        },
        "handoff_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
