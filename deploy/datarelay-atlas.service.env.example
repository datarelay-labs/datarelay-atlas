# Copy to /etc/datarelay-atlas/service.env outside Git.
# Owner root, group atlas, mode 0640. Do not commit the filled file.
# The introspection client secret belongs in the secret file, mode 0640.
# GITHUB_TOKEN is not a service setting; export it only for atlas sync.

ATLAS_DATA_ROOT=/var/lib/datarelay-atlas
# Bind stays on loopback. Port 443 ingress forwards to 8443.
# The resource URL is the public audience, not the bind address.
ATLAS_MCP_BIND_HOST=127.0.0.1
ATLAS_MCP_BIND_PORT=8443
ATLAS_MCP_RESOURCE_URL=https://mcp.atlas.datarelay.run/mcp
ATLAS_MCP_ISSUER_URL=https://issuer.example
ATLAS_MCP_INTROSPECTION_URL=https://issuer.example/oauth/introspect
ATLAS_MCP_INTROSPECTION_CLIENT_ID=atlas-resource
ATLAS_MCP_INTROSPECTION_CLIENT_SECRET_FILE=/etc/datarelay-atlas/introspection-client-secret
ATLAS_MCP_TLS_CERT=/etc/datarelay-atlas/tls/cert.pem
ATLAS_MCP_TLS_KEY=/etc/datarelay-atlas/tls/key.pem
