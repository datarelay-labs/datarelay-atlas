[Unit]
Description=DataRelay Atlas SNI TLS ingress on TCP port 443
Documentation=file:/opt/datarelay-atlas/docs/runbooks/phase2-production-service.md
After=datarelay-atlas.service keycloak.service
Requires=datarelay-atlas.service
Wants=keycloak.service

[Service]
ExecStart=/opt/datarelay-atlas/.venv/bin/python -m atlas.sni_ingress
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET
IPAddressAllow=localhost
IPAddressDeny=any
